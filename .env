# ==============================================================================
# NFO UPDATER — DOCKER CONFIGURATION
# ==============================================================================
# This is the whole configuration. Docker Compose reads it and passes it into
# the container, which builds NFO Updater's configuration file from it on every
# start. There is no second file to edit and nothing kept between runs: what is
# written here is what the program sees.
#
# THREE THINGS HAVE TO BE FILLED IN — the three API keys further down. Every
# other setting already has a sensible value.
#
# THE LIBRARY IS NOT CONFIGURED HERE. It is mounted in docker-compose.yml, in
# the volumes section, which is also where the instructions for it are.
#
# Rules:
#   - An empty value means the built-in default. Emptying a line is a safe way
#     to undo a change, and a setting added by a future release keeps its
#     default until you add it here yourself.
#   - Do not put values in quotes. Compose keeps the quotes as part of the
#     value.
#   - A $ in a value has to be doubled: $$ . None of the settings below
#     normally contains one.
#   - Applying a change means recreating the container: docker compose up -d .
#     A restart is not enough, because a container keeps the environment it
#     was created with.

# ------------------------------------------------------------------------------
# CONTAINER
# ------------------------------------------------------------------------------

# Time zone the schedule is evaluated in. Without it the container runs on UTC,
# and a pass set for 03:00 happens at 03:00 UTC.
# Example: TZ=Europe/Berlin
TZ=Etc/UTC

# Which image to run. Pin it to a version number to stay on a known build.
# Example: IMAGE_TAG=1.1.0
IMAGE_TAG=latest

# ------------------------------------------------------------------------------
# ONLINE DATABASES
# ------------------------------------------------------------------------------
# IMPORTANT: All services must be configured!

# OMDb API
# https://www.omdbapi.com/apikey.aspx
# The key arrives by email and has to be activated by the link in it. Until
# that is done the service answers as if the key were wrong.
# Multiple keys can be comma-separated without spaces
# Example: OMDB_API_KEYS=x00xx00,000xx000
OMDB_API_KEYS=
# This is a limit you set for yourself: lower it to leave headroom for other
# tools sharing the same key, or raise it if your account allows more.
# Default: 1000
OMDB_DAILY_LIMIT_PER_KEY=

# MDBList API
# https://mdblist.com/preferences/
# Multiple keys can be comma-separated without spaces
# Example: MDBLIST_API_KEYS=0xxxxxxxxxxxxxxxxxxxxxxxx,1yyyyyyyyyyyyyyyyyyyyyyyy
MDBLIST_API_KEYS=
# This is a limit you set for yourself: lower it to leave headroom for other
# tools sharing the same key, or raise it if your account allows more.
# Default: 1000
MDBLIST_DAILY_LIMIT_PER_KEY=

# TMDb API
# https://www.themoviedb.org/settings/api
# Use the "API Key" value: 32 characters, digits and lowercase a-f.
# Do NOT use the "API Read Access Token" shown next to it on the same page.
# That token belongs to a different authentication scheme, and will be rejected.
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# SCHEDULE
# ------------------------------------------------------------------------------

# Cron schedule: minute hour day month weekday.
# Empty = every Monday at 03:00. It runs for as long as the container is up.
# Example: SCHEDULE=0 3 * * 1
SCHEDULE=

# ------------------------------------------------------------------------------
# DATA TO UPDATE / INCLUDE
# ------------------------------------------------------------------------------
# Enabled ratings are written to the NFO file as named entries inside the
# <ratings> block, which is the standard Kodi format.
#
# A rating already present in a file is never dropped just because it could
# not be fetched this time — the previous value is kept. Setting a provider
# to "no" below, however, does remove it from the files on the next run.
# Other ratings are left untouched either way.

# AUDIENCE RATINGS
#
# IMDb rating
IMDB_RATING=yes
# TMDb rating
TMDB_RATING=no
# Tomato Audience rating
POPCORN_RATING=no
# Trakt rating
TRAKT_RATING=no

# CRITIC RATINGS
#
# Tomato Critics rating
TOMATOES_RATING=yes
# Metacritic rating
METACRITIC_RATING=no

# Default rating provider (imdb, tmdb, popcorn, trakt, metacritic, tomatoes).
# This is the rating Kodi treats as the main one for the item, marked in the
# file with default="true".
# Must be specified in lowercase, and must be one of the enabled rating
# providers above. The audience/critic grouping is informational only: any of
# the six may be used here.
# If the chosen provider has no data for a particular title, the first
# available one is used instead, in the order listed above.
# Default: imdb
DEFAULT_RATING=imdb

# Move the <credits> and <director> tags below the <actor> entries.
#
# This is about display order, and nothing is added or removed either way.
# Emby used to lay out an item page on its own — cast first, crew after it,
# the way most catalogues do — regardless of how the NFO file was written.
# A later update changed that: Emby now follows the order of the file exactly,
# so a file that lists the crew above the cast is displayed crew first.
# Turning this on restores the customary order.
#
# Kodi is not affected by the order. Jellyfin was not checked.
#
# Note that this is the only change NFO Updater makes that REORDERS existing
# tags rather than adding new ones. Everything else it writes is purely
# additive, and no tag is ever deleted. Once a file has been rewritten,
# setting this back to "no" does not restore the original order — a backup
# is the only way back.
#
# This setting is independent of EMBY_ENABLED further down. That one only
# controls whether the server is asked to rescan its library, which is an
# unrelated question: a library browsed with Emby benefits from this order
# whether or not NFO Updater ever talks to the server.
#
# Empty = yes.
# Default: yes
CREW_ORDER_FIX=yes

# ------------------------------------------------------------------------------
# BACKUPS
# ------------------------------------------------------------------------------

# Backup original NFO files before overwriting them.
# Backups are stored as zip archives, one per run, separately for movies and
# TV shows, under data/backups next to docker-compose.yml:
#   Movies/YYYY-MM-DD_HH-MM-SS.zip
#   TVShows/YYYY-MM-DD_HH-MM-SS.zip
# Inside an archive every file keeps its full path AS SEEN FROM INSIDE THE
# CONTAINER: a file mounted at /movies/films is stored under that name, not
# under its path on this machine.
# Each archive contains only the files that were actually changed during that
# run.
BACKUP_ENABLED=yes
# Number of archives to keep, counted separately per category (movies and
# TV shows each keep their own last BACKUP_LIMIT archives). Oldest archives
# beyond this count are deleted automatically. 0 = unlimited, never delete.
# Default: 10
BACKUP_LIMIT=

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
# What happens during a run also goes to the container log, which is what
# docker compose logs shows. The files below are a second, permanent copy,
# under data/logs next to docker-compose.yml.

# File logging
LOG_ENABLED=yes
# Verbose logging: also log routine, non-actionable events (file unchanged,
# value taken from cache, etc). Off by default — meant for troubleshooting
# a specific issue, not for permanent use.
LOG_VERBOSE=no
# Number of log files to keep. Older files beyond this count are deleted
# automatically when a new run starts.
# Default: 10
LOG_LIMIT=

# ------------------------------------------------------------------------------
# NETWORK BEHAVIOUR
# ------------------------------------------------------------------------------

# Circuit breaker: consecutive network failures before a provider is
# considered down for the rest of the run, and the pause between retries.
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_BACKOFF_SECONDS=5

# ------------------------------------------------------------------------------
# MEDIA SERVERS (Library refresh triggers after NFO updates)
# ------------------------------------------------------------------------------
# Optional: media servers rescan their libraries on their own schedule anyway,
# and these settings only make the updated ratings appear sooner.
#
# How it works:
#   - a full library scan is requested and the server decides for itself what
#     actually needs re-reading;
#   - the request is sent only if at least one file was changed during the
#     run — an unchanged library never triggers a scan;
#   - each enabled server is contacted once at the start of a run to verify
#     the address and the key;
#   - a server that is unreachable or rejects its key does NOT fail the run.
#     The ratings are already written to disk, and the server will pick them
#     up on its own next scan.
#
# Note that when a server is enabled, its address and key must both be filled
# in, otherwise the configuration is rejected.
#
# The address must be reachable FROM INSIDE THE CONTAINER. localhost there is
# the container itself, not the machine it runs on, so a server on this same
# machine is reached by that machine's address on the network.

# Emby Server
EMBY_ENABLED=no
# Server network address, including http:// or https://
# Example: EMBY_URL=http://192.168.1.10:8096
EMBY_URL=
# API key created in Emby dashboard: Settings — API Keys
EMBY_API_KEY=
#
# Emby displays only two ratings per item, and picks them from the NFO
# like this:
#   - audience rating: the provider set in DEFAULT_RATING above;
#   - critic rating: Tomato Critics. No other provider can fill this slot,
#     so it stays empty when TOMATOES_RATING=no.
# All remaining ratings are still written to the file for Kodi, but Emby
# ignores them.
# Special case: when DEFAULT_RATING=tomatoes, Emby will not reuse that same
# value as the audience rating. It falls back to the first enabled provider
# in this order: imdb, tmdb, popcorn, trakt, metacritic.
#
# See also CREW_ORDER_FIX above: current Emby versions list the cast and the
# crew in the order they appear in the file. It applies whether or not this
# server is enabled.

# Jellyfin Server
JELLYFIN_ENABLED=no
# Server network address, including http:// or https://
# Example: JELLYFIN_URL=http://192.168.1.11:8096
JELLYFIN_URL=
# API key created in Jellyfin dashboard: Settings — API Keys
JELLYFIN_API_KEY=
#
# Jellyfin uses the same two-rating model as Emby. Its exact selection rules
# were not verified, so the notes above may not apply to it in full.

# Plex Media Server
PLEX_ENABLED=no
# Server network address, including http:// or https://
# Example: PLEX_URL=http://192.168.1.12:32400
PLEX_URL=
# Plex authentication token
# https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=
# Section (library) ids to rescan, comma-separated without spaces.
# A section id is the number that appears in the address bar of the Plex web
# app when that library is open — not the library name.
# Leave empty to let NFO Updater ask the server for its sections and rescan
# every movie and TV show library it finds.
# Example: PLEX_SECTION_IDS=1,4
PLEX_SECTION_IDS=
