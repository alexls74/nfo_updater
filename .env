# ------------------------------------------------------------------------------
# Settings for docker-compose.yml
# ------------------------------------------------------------------------------
# This file is read by Docker Compose itself, not by NFO Updater. It only fills
# in the blanks in docker-compose.yml: which directories to mount, which user
# to run as, which time zone to use.
#
# Nothing secret belongs here. The API keys live in config.conf, inside the
# ./config directory, and are never passed through the environment.

# Where your media library is on this machine. Both paths are mounted into the
# container unchanged, so these are also the paths to give NFO Updater when it
# asks. Absolute paths only.
#
# If you only have one of the two categories, remove the matching line from
# docker-compose.yml as well: an empty value here is not a valid mount.
MOVIES_PATH=/mnt/media/movies
TVSHOWS_PATH=/mnt/media/tvshows

# The user the container runs as, which decides who owns the files it writes
# into ./config and ./data. Use the output of `id -u` and `id -g`.
PUID=1000
PGID=1000

# Time zone for the schedule. Without it the container runs on UTC and a pass
# set for 03:00 happens at 03:00 UTC.
# Example: TZ=Europe/Berlin
TZ=Etc/UTC

# Image tag to run. Pin it to a version number to stay on a known build.
# Example: IMAGE_TAG=1.0.7
IMAGE_TAG=latest
